# Topaz-VBE replica — copy to .env and adjust before first start.
#   cp .env.example .env
#   docker compose up --build

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_DB=topaz
POSTGRES_USER=topaz
POSTGRES_PASSWORD=topaz

# --- Backend API --------------------------------------------------------------
API_PORT=8000
# Used to sign JWTs. CHANGE THIS in any shared/production deployment.
SECRET_KEY=change-me-in-production
# Demo admin account (created on first API start if the admins table is empty).
# DEMO-GRADE: stored as a SHA256 hex digest, NOT bcrypt — see README security note.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# Quarter-roll execution: "queue" (API enqueues, engine worker runs the batch)
# or "sync" (API runs the engine as a subprocess and waits).
QUARTER_ROLL_MODE=queue

# --- Engine worker ------------------------------------------------------------
WORKER_POLL_SECONDS=5

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=8080
